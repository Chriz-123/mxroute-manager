<UserControl x:Class="MxRouteManager.Views.SpamView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:MxRouteManager.Localization"
             Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel HorizontalAlignment="Left">
                <TextBlock Text="{loc:Tr Nav_Spam}" Style="{StaticResource H1}" />
                <TextBlock Text="{Binding Host.SelectedDomain}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
            </StackPanel>
            <Button Content="{loc:Tr Common_Refresh}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right"
                    Command="{Binding RefreshCommand}" />
        </Grid>

        <!-- Score -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="{loc:Tr Spam_ScoreTitle}" Style="{StaticResource H2}" />
                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,12"
                           Text="{loc:Tr Spam_ScoreDesc}" />
                <StackPanel Orientation="Horizontal">
                    <Slider Width="320" Minimum="1" Maximum="50" TickFrequency="1" IsSnapToTickEnabled="True"
                            Value="{Binding HighScore}" VerticalAlignment="Center" />
                    <TextBox Width="60" Margin="14,0" Text="{Binding HighScore, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Content="{loc:Tr Common_Save}" Style="{StaticResource PrimaryButton}" Command="{Binding SaveSettingsCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Listen -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Whitelist -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="{loc:Tr Spam_Whitelist}" Style="{StaticResource H2}" HorizontalAlignment="Left"
                                   Foreground="{StaticResource SuccessBrush}" />
                        <Button Content="{loc:Tr Spam_AddEntry}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right"
                                Command="{Binding AddWhitelistCommand}" />
                    </Grid>
                    <ListBox Grid.Row="1" ItemsSource="{Binding Whitelist}" SelectedItem="{Binding SelectedWhitelist}"
                             Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" MinHeight="180" />
                    <Button Grid.Row="2" Content="{loc:Tr Common_Remove}" Style="{StaticResource DangerButton}" HorizontalAlignment="Left"
                            Margin="0,10,0,0" Command="{Binding RemoveWhitelistCommand}" />
                </Grid>
            </Border>

            <!-- Blacklist -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="{loc:Tr Spam_Blacklist}" Style="{StaticResource H2}" HorizontalAlignment="Left"
                                   Foreground="{StaticResource DangerBrush}" />
                        <Button Content="{loc:Tr Spam_AddEntry}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right"
                                Command="{Binding AddBlacklistCommand}" />
                    </Grid>
                    <ListBox Grid.Row="1" ItemsSource="{Binding Blacklist}" SelectedItem="{Binding SelectedBlacklist}"
                             Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" MinHeight="180" />
                    <Button Grid.Row="2" Content="{loc:Tr Common_Remove}" Style="{StaticResource DangerButton}" HorizontalAlignment="Left"
                            Margin="0,10,0,0" Command="{Binding RemoveBlacklistCommand}" />
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Margin="0,14,0,0" CornerRadius="6" Padding="12,10"
                Background="{StaticResource SurfaceAltBrush}"
                Visibility="{Binding StatusMessage, Converter={StaticResource NotEmptyToVis}}">
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"
                       Foreground="{Binding StatusIsError, Converter={StaticResource BoolToStatusBrush}, ConverterParameter=invert}" />
        </Border>
    </Grid>
</UserControl>

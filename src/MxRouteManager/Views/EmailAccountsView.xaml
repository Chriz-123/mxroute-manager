<UserControl x:Class="MxRouteManager.Views.EmailAccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel HorizontalAlignment="Left">
                <TextBlock Text="E-Mail-Konten" Style="{StaticResource H1}" />
                <TextBlock Text="{Binding Host.SelectedDomain}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="+  Konto anlegen" Style="{StaticResource PrimaryButton}" Command="{Binding CreateCommand}" />
                <Button Content="Bearbeiten" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                        Command="{Binding EditCommand}" IsEnabled="{Binding HasSelection}" />
                <Button Content="Loeschen" Style="{StaticResource DangerButton}" Margin="8,0,0,0"
                        Command="{Binding DeleteCommand}" IsEnabled="{Binding HasSelection}" />
                <Button Content="&#x21BB;" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Command="{Binding RefreshCommand}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <DataGrid ItemsSource="{Binding Accounts}" SelectedItem="{Binding Selected}" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Benutzer" Binding="{Binding Username}" Width="160" />
                    <DataGridTextColumn Header="E-Mail-Adresse" Binding="{Binding Email}" Width="*" />
                    <DataGridTextColumn Header="Quota" Binding="{Binding QuotaDisplay}" Width="110" />
                    <DataGridTextColumn Header="Belegt" Binding="{Binding UsageDisplay}" Width="110" />
                    <DataGridTextColumn Header="Gesendet (heute)" Binding="{Binding SentDisplay}" Width="140" />
                    <DataGridTextColumn Header="Status" Binding="{Binding StatusDisplay}" Width="90" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="2" Margin="0,14,0,0" CornerRadius="6" Padding="12,10"
                Background="{StaticResource SurfaceAltBrush}"
                Visibility="{Binding StatusMessage, Converter={StaticResource NotEmptyToVis}}">
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"
                       Foreground="{Binding StatusIsError, Converter={StaticResource BoolToStatusBrush}, ConverterParameter=invert}" />
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="MxRouteManager.Views.EmailAccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:MxRouteManager.Localization"
             Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel HorizontalAlignment="Left">
                <TextBlock Text="{loc:Tr Nav_Email}" Style="{StaticResource H1}" />
                <TextBlock Text="{Binding Host.SelectedDomain}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{loc:Tr Email_Create}" Style="{StaticResource PrimaryButton}" Command="{Binding CreateCommand}" />
                <Button Content="{loc:Tr Common_Edit}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                        Command="{Binding EditCommand}" IsEnabled="{Binding HasSelection}" />
                <Button Content="{loc:Tr Common_Delete}" Style="{StaticResource DangerButton}" Margin="8,0,0,0"
                        Command="{Binding DeleteCommand}" IsEnabled="{Binding HasSelection}" />
                <Button Content="&#x21BB;" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Command="{Binding RefreshCommand}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <DataGrid ItemsSource="{Binding Accounts}" SelectedItem="{Binding Selected}" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{loc:Tr Email_User}" Binding="{Binding Username}" Width="160" />
                    <DataGridTextColumn Header="{loc:Tr Common_EmailAddress}" Binding="{Binding Email}" Width="*" />
                    <DataGridTextColumn Header="{loc:Tr Email_Quota}" Binding="{Binding QuotaDisplay}" Width="110" />
                    <DataGridTextColumn Header="{loc:Tr Email_Used}" Binding="{Binding UsageDisplay}" Width="110" />
                    <DataGridTextColumn Header="{loc:Tr Email_SentToday}" Binding="{Binding SentDisplay}" Width="140" />
                    <DataGridTextColumn Header="{loc:Tr Common_Status}" Binding="{Binding StatusDisplay}" Width="90" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="2" Margin="0,14,0,0" CornerRadius="6" Padding="12,10"
                Background="{StaticResource SurfaceAltBrush}"
                Visibility="{Binding StatusMessage, Converter={StaticResource NotEmptyToVis}}">
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"
                       Foreground="{Binding StatusIsError, Converter={StaticResource BoolToStatusBrush}, ConverterParameter=invert}" />
        </Border>
    </Grid>
</UserControl>

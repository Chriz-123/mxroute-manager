<UserControl x:Class="MxRouteManager.Views.ConnectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:MxRouteManager.Localization"
             Background="{StaticResource BackgroundBrush}">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Border Style="{StaticResource Card}" Width="440" Margin="0,40" VerticalAlignment="Top" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{loc:Tr Conn_Title}" Style="{StaticResource H1}" />
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,20"
                               Text="{loc:Tr Conn_Desc}" />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Conn_ServerLabel}" />
                    <TextBox Text="{Binding Server, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource Muted}" Text="{loc:Tr Conn_ServerHint}" Margin="0,4,0,0" />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Conn_UserLabel}" Margin="0,14,0,4" />
                    <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Conn_KeyLabel}" Margin="0,14,0,4" />
                    <PasswordBox x:Name="ApiKeyBox" />

                    <CheckBox Content="{loc:Tr Conn_Remember}"
                              IsChecked="{Binding RememberCredentials}" Margin="0,16,0,0" />

                    <Button Content="{loc:Tr Conn_Connect}" Style="{StaticResource PrimaryButton}" Margin="0,20,0,0"
                            HorizontalAlignment="Stretch" Height="40"
                            Command="{Binding ConnectCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />

                    <TextBlock Text="{loc:Tr Conn_Connecting}" Style="{StaticResource Muted}" Margin="0,10,0,0"
                               HorizontalAlignment="Center"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

                    <Border Margin="0,14,0,0" CornerRadius="6" Padding="12,10"
                            Background="{StaticResource SurfaceAltBrush}"
                            Visibility="{Binding StatusMessage, Converter={StaticResource NotEmptyToVis}}">
                        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"
                                   Foreground="{Binding StatusIsError, Converter={StaticResource BoolToStatusBrush}, ConverterParameter=invert}" />
                    </Border>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>

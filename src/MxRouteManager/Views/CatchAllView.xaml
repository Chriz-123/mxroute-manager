<UserControl x:Class="MxRouteManager.Views.CatchAllView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:MxRouteManager.Localization"
             Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel HorizontalAlignment="Left">
                <TextBlock Text="{loc:Tr Nav_CatchAll}" Style="{StaticResource H1}" />
                <TextBlock Text="{Binding Host.SelectedDomain}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
            </StackPanel>
            <Button Content="{loc:Tr Common_Refresh}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right"
                    Command="{Binding RefreshCommand}" />
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Width="560" HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock Text="{loc:Tr CatchAll_Heading}" Style="{StaticResource H2}" Margin="0,0,0,14" TextWrapping="Wrap" />

                <RadioButton GroupName="ca" Margin="0,4" Foreground="{StaticResource TextBrush}"
                             IsChecked="{Binding SelectedType, Converter={StaticResource StringEquals}, ConverterParameter=fail}">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr CatchAll_Fail}" FontWeight="SemiBold" />
                        <TextBlock Text="{loc:Tr CatchAll_FailDesc}" Style="{StaticResource Muted}" />
                    </StackPanel>
                </RadioButton>

                <RadioButton GroupName="ca" Margin="0,8" Foreground="{StaticResource TextBrush}"
                             IsChecked="{Binding SelectedType, Converter={StaticResource StringEquals}, ConverterParameter=blackhole}">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr CatchAll_Blackhole}" FontWeight="SemiBold" />
                        <TextBlock Text="{loc:Tr CatchAll_BlackholeDesc}" Style="{StaticResource Muted}" />
                    </StackPanel>
                </RadioButton>

                <RadioButton GroupName="ca" Margin="0,8" Foreground="{StaticResource TextBrush}"
                             IsChecked="{Binding SelectedType, Converter={StaticResource StringEquals}, ConverterParameter=address}">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr CatchAll_Address}" FontWeight="SemiBold" />
                        <TextBlock Text="{loc:Tr CatchAll_AddressDesc}" Style="{StaticResource Muted}" />
                    </StackPanel>
                </RadioButton>

                <TextBlock Text="{loc:Tr CatchAll_TargetAddress}" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
                <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsAddressType}" />

                <Button Content="{loc:Tr Common_Save}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                        Margin="0,18,0,0" Command="{Binding SaveCommand}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Margin="0,14,0,0" CornerRadius="6" Padding="12,10"
                Background="{StaticResource SurfaceAltBrush}"
                Visibility="{Binding StatusMessage, Converter={StaticResource NotEmptyToVis}}">
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"
                       Foreground="{Binding StatusIsError, Converter={StaticResource BoolToStatusBrush}, ConverterParameter=invert}" />
        </Border>
    </Grid>
</UserControl>

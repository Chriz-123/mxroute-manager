<UserControl x:Class="MxRouteManager.Views.CatchAllView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel HorizontalAlignment="Left">
                <TextBlock Text="Catch-All" Style="{StaticResource H1}" />
                <TextBlock Text="{Binding Host.SelectedDomain}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
            </StackPanel>
            <Button Content="&#x21BB;  Aktualisieren" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right"
                    Command="{Binding RefreshCommand}" />
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Width="560" HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock Text="Verhalten fuer E-Mails an nicht existierende Adressen" Style="{StaticResource H2}" Margin="0,0,0,14" />

                <RadioButton GroupName="ca" Margin="0,4" Foreground="{StaticResource TextBrush}"
                             IsChecked="{Binding SelectedType, Converter={StaticResource StringEquals}, ConverterParameter=fail}">
                    <StackPanel>
                        <TextBlock Text="Ablehnen (fail)" FontWeight="SemiBold" />
                        <TextBlock Text="E-Mails an unbekannte Adressen werden zurueckgewiesen." Style="{StaticResource Muted}" />
                    </StackPanel>
                </RadioButton>

                <RadioButton GroupName="ca" Margin="0,8" Foreground="{StaticResource TextBrush}"
                             IsChecked="{Binding SelectedType, Converter={StaticResource StringEquals}, ConverterParameter=blackhole}">
                    <StackPanel>
                        <TextBlock Text="Verwerfen (blackhole)" FontWeight="SemiBold" />
                        <TextBlock Text="E-Mails werden stillschweigend geloescht." Style="{StaticResource Muted}" />
                    </StackPanel>
                </RadioButton>

                <RadioButton GroupName="ca" Margin="0,8" Foreground="{StaticResource TextBrush}"
                             IsChecked="{Binding SelectedType, Converter={StaticResource StringEquals}, ConverterParameter=address}">
                    <StackPanel>
                        <TextBlock Text="An Adresse weiterleiten" FontWeight="SemiBold" />
                        <TextBlock Text="Alle E-Mails an ein bestimmtes Postfach weiterleiten." Style="{StaticResource Muted}" />
                    </StackPanel>
                </RadioButton>

                <TextBlock Text="Zieladresse" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
                <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsAddressType}" />

                <Button Content="Speichern" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                        Margin="0,18,0,0" Command="{Binding SaveCommand}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Margin="0,14,0,0" CornerRadius="6" Padding="12,10"
                Background="{StaticResource SurfaceAltBrush}"
                Visibility="{Binding StatusMessage, Converter={StaticResource NotEmptyToVis}}">
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"
                       Foreground="{Binding StatusIsError, Converter={StaticResource BoolToStatusBrush}, ConverterParameter=invert}" />
        </Border>
    </Grid>
</UserControl>

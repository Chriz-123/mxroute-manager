<UserControl x:Class="MxRouteManager.Views.DnsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel HorizontalAlignment="Left">
                <TextBlock Text="DNS-Konfiguration" Style="{StaticResource H1}" />
                <TextBlock Text="{Binding Host.SelectedDomain}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
            </StackPanel>
            <Button Content="&#x21BB;  Aktualisieren" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right"
                    Command="{Binding RefreshCommand}" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,14"
                           Text="Diese Eintraege beim DNS-Anbieter der Domain setzen, damit E-Mail korrekt funktioniert." />

                <!-- MX -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="MX-Eintraege" Style="{StaticResource H2}" Margin="0,0,0,10" />
                        <DataGrid ItemsSource="{Binding MxRecords}" MaxHeight="200" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Prioritaet" Binding="{Binding Priority}" Width="110" />
                                <DataGridTextColumn Header="Hostname" Binding="{Binding Hostname}" Width="*" />
                                <DataGridTextColumn Header="Beschreibung" Binding="{Binding Description}" Width="220" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- SPF -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="SPF" Style="{StaticResource H2}" Margin="0,0,0,8" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Typ / Name" />
                        <TextBlock Margin="0,0,0,8">
                            <Run Text="{Binding Spf.Type}" /> <Run Text="  " /> <Run Text="{Binding Spf.Name}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Wert" />
                        <TextBox Text="{Binding Spf.Value, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- DKIM -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16"
                        Visibility="{Binding HasDkim, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="DKIM" Style="{StaticResource H2}" Margin="0,0,0,8" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Typ / Name" />
                        <TextBlock Margin="0,0,0,8">
                            <Run Text="{Binding Dkim.Type}" /> <Run Text="  " /> <Run Text="{Binding Dkim.Name}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Wert" />
                        <TextBox Text="{Binding Dkim.Value, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Verification -->
                <Border Style="{StaticResource Card}"
                        Visibility="{Binding HasVerification, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Domain-Verifizierung" Style="{StaticResource H2}" Margin="0,0,0,8" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Typ / Name" />
                        <TextBlock Margin="0,0,0,8">
                            <Run Text="{Binding Verification.Type}" /> <Run Text="  " /> <Run Text="{Binding Verification.Name}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Wert" />
                        <TextBox Text="{Binding Verification.Value, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

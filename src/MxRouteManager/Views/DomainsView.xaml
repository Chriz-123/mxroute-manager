<UserControl x:Class="MxRouteManager.Views.DomainsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Kopf -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Domains" Style="{StaticResource H1}" HorizontalAlignment="Left" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="+  Domain hinzufuegen" Style="{StaticResource PrimaryButton}" Command="{Binding AddDomainCommand}" />
                <Button Content="&#x21BB;" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Command="{Binding RefreshCommand}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Liste -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="8">
                <ListBox ItemsSource="{Binding Domains}" SelectedItem="{Binding SelectedName}"
                         Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="10,8" />
                            <Setter Property="Margin" Value="2" />
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentBrush}" />
                                                <Setter Property="Foreground" Value="White" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Border>

            <!-- Details -->
            <Border Grid.Column="2" Style="{StaticResource Card}"
                    Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{Binding SelectedName}" Style="{StaticResource H2}" FontSize="18" />
                    <Separator Margin="0,12" Background="{StaticResource BorderBrush}" />

                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="SSL aktiv" Style="{StaticResource Muted}" HorizontalAlignment="Left" />
                        <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold"
                                   Text="{Binding Details.SslEnabled}" />
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <CheckBox Content="Mail-Hosting aktiviert" IsChecked="{Binding DetailsMailHosting}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button HorizontalAlignment="Right" Content="Uebernehmen" Style="{StaticResource SecondaryButton}"
                                Command="{Binding ApplyMailHostingCommand}" />
                    </Grid>

                    <TextBlock Text="Pointer" Style="{StaticResource FieldLabel}" Margin="0,4,0,6" />
                    <ItemsControl ItemsSource="{Binding Details.Pointers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Margin="0,2" Foreground="{StaticResource MutedTextBrush}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Content="Domain loeschen" Style="{StaticResource DangerButton}" Margin="0,20,0,0"
                            HorizontalAlignment="Left" Command="{Binding DeleteDomainCommand}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Statusleiste -->
        <Border Grid.Row="2" Margin="0,14,0,0" CornerRadius="6" Padding="12,10"
                Background="{StaticResource SurfaceAltBrush}"
                Visibility="{Binding StatusMessage, Converter={StaticResource NotEmptyToVis}}">
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"
                       Foreground="{Binding StatusIsError, Converter={StaticResource BoolToStatusBrush}, ConverterParameter=invert}" />
        </Border>
    </Grid>
</UserControl>

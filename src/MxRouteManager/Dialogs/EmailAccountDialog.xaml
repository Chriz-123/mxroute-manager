<Window x:Class="MxRouteManager.Dialogs.EmailAccountDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MxRouteManager.Localization"
        Title="E-Mail-Konto" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">
    <Border Padding="22">
        <StackPanel>
            <TextBlock x:Name="HeaderText" Style="{StaticResource H2}" Text="" Margin="0,0,0,16" />

            <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr EmailDlg_Username}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="UsernameBox" Grid.Column="0" />
                <TextBlock x:Name="DomainSuffix" Grid.Column="1" Style="{StaticResource Muted}" Margin="8,0,0,0" />
            </Grid>

            <TextBlock x:Name="PasswordLabel" Style="{StaticResource FieldLabel}" Text="{loc:Tr EmailDlg_Password}" Margin="0,14,0,4" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <PasswordBox x:Name="PasswordBox" Grid.Column="0" />
                <Button Grid.Column="1" Content="{loc:Tr EmailDlg_Generate}" Style="{StaticResource SecondaryButton}"
                        Margin="8,0,0,0" Padding="10,7" Click="Generate_Click" />
            </Grid>
            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0" Text="{loc:Tr EmailDlg_PwHint}" />

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr EmailDlg_Quota}" />
                    <TextBox x:Name="QuotaBox" Text="1024" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr EmailDlg_Limit}" />
                    <TextBox x:Name="LimitBox" Text="9600" />
                </StackPanel>
            </Grid>

            <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                       Margin="0,12,0,0" Visibility="Collapsed" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="{loc:Tr Common_Cancel}" Style="{StaticResource SecondaryButton}" Width="110" IsCancel="True" Click="Cancel_Click" />
                <Button x:Name="OkButton" Content="" Style="{StaticResource PrimaryButton}" Width="110" Margin="10,0,0,0" IsDefault="True" Click="Ok_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>

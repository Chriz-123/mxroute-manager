<Window x:Class="MxRouteManager.Dialogs.TextInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Eingabe" Height="Auto" Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">
    <Border Padding="22">
        <StackPanel>
            <TextBlock x:Name="TitleText" Style="{StaticResource H2}" Text="Eingabe" Margin="0,0,0,4" />
            <TextBlock x:Name="PromptText" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,14" />
            <TextBox x:Name="InputBox" />
            <TextBlock x:Name="HintText" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Abbrechen" Style="{StaticResource SecondaryButton}" Width="110" IsCancel="True" Click="Cancel_Click" />
                <Button Content="OK" Style="{StaticResource PrimaryButton}" Width="110" Margin="10,0,0,0" IsDefault="True" Click="Ok_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>

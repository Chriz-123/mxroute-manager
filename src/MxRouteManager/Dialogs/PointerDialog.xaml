<Window x:Class="MxRouteManager.Dialogs.PointerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Domain-Pointer anlegen" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">
    <Border Padding="22">
        <StackPanel>
            <TextBlock Style="{StaticResource H2}" Text="Domain-Pointer anlegen" Margin="0,0,0,4" />
            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,14"
                       Text="Eine weitere Domain, die auf die aktuelle Domain zeigt." />

            <TextBlock Style="{StaticResource FieldLabel}" Text="Pointer-Domain" />
            <TextBox x:Name="PointerBox" />

            <TextBlock Style="{StaticResource FieldLabel}" Text="Typ" Margin="0,14,0,4" />
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="AliasRadio" Content="Alias" IsChecked="True" Foreground="{StaticResource TextBrush}" Margin="0,0,20,0" />
                <RadioButton x:Name="RedirectRadio" Content="Weiterleitung (Redirect)" Foreground="{StaticResource TextBrush}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Content="Abbrechen" Style="{StaticResource SecondaryButton}" Width="110" IsCancel="True" Click="Cancel_Click" />
                <Button Content="Anlegen" Style="{StaticResource PrimaryButton}" Width="110" Margin="10,0,0,0" IsDefault="True" Click="Ok_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>

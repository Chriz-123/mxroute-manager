<Window x:Class="MxRouteManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MxRouteManager.ViewModels"
        Title="MXroute Manager" Height="760" Width="1180"
        MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============ Sidebar ============ -->
        <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Logo / Titel -->
                <StackPanel Grid.Row="0" Margin="20,22,20,18">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x1F4E7;" FontSize="22" VerticalAlignment="Center" />
                        <TextBlock Text="MXroute" Style="{StaticResource H1}" FontSize="20" Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="Manager" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                </StackPanel>

                <!-- Navigation -->
                <ItemsControl Grid.Row="1" ItemsSource="{Binding NavItems}" IsEnabled="{Binding IsConnected}" Margin="0,4,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:NavItem}">
                            <RadioButton GroupName="nav" Style="{StaticResource NavButton}"
                                         Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                         CommandParameter="{Binding Key}">
                                <RadioButton.IsChecked>
                                    <MultiBinding Converter="{StaticResource MultiEquals}" Mode="OneWay">
                                        <Binding Path="DataContext.CurrentNavKey" RelativeSource="{RelativeSource AncestorType=Window}" />
                                        <Binding Path="Key" />
                                    </MultiBinding>
                                </RadioButton.IsChecked>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Icon}" FontSize="15" Width="24" />
                                    <TextBlock Text="{Binding Title}" />
                                </StackPanel>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Verbindungsstatus / Trennen -->
                <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                     Fill="{Binding IsConnected, Converter={StaticResource BoolToStatusBrush}}" />
                            <TextBlock Text="{Binding ConnectionLabel}" Style="{StaticResource Muted}" Margin="8,0,0,0"
                                       TextTrimming="CharacterEllipsis" MaxWidth="170" />
                        </StackPanel>
                        <Button Content="Verbindung trennen" Style="{StaticResource SecondaryButton}"
                                Command="{Binding DisconnectCommand}"
                                Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}"
                                HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ============ Inhalt ============ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top-Leiste: Domain-Auswahl -->
            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                    Padding="24,12" Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <TextBlock Text="Aktive Domain:" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <ComboBox Width="280" ItemsSource="{Binding Domains}" SelectedItem="{Binding SelectedDomain}" />
                        <Button Content="&#x21BB;  Aktualisieren" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0"
                                Command="{Binding ReloadDomainsCommand}" />
                        <TextBlock Text="Keine Domains vorhanden" Style="{StaticResource Muted}" Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding HasDomains, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Seiteninhalt -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" Margin="0" />
        </Grid>
    </Grid>
</Window>
